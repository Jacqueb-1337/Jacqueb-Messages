<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conversation_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="82dp"
    android:paddingStart="20dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <ImageView android:id="@+id/conversation_image"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:src="@mipmap/ic_launcher" />

    <org.fossify.commons.views.MyTextView android:id="@+id/conversation_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="16sp"
        android:textColor="@color/samsung_text_primary"
        app:layout_constraintStart_toEndOf="@id/conversation_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/conversation_date"
        tools:text="Contact name" />

    <org.fossify.commons.views.MyTextView android:id="@+id/conversation_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="126dp"
        android:singleLine="true"
        android:textSize="13sp"
        android:textColor="@color/samsung_text_secondary"
        app:layout_constraintBaseline_toBaselineOf="@id/conversation_address"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Oct 28" />

    <!-- Keep the message preview on the left and the draft marker to its right.
         Separate views reserve space for Draft even when the preview is long. -->
    <org.fossify.commons.views.MyTextView android:id="@+id/conversation_body_short"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginStart="14dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/samsung_text_secondary"
        app:layout_constraintStart_toEndOf="@id/conversation_image"
        app:layout_constraintTop_toBottomOf="@id/conversation_address"
        app:layout_constraintEnd_toStartOf="@id/draft_indicator"
        tools:text="Last message preview appears here" />

    <org.fossify.commons.views.MyTextView android:id="@+id/draft_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:maxLines="1"
        android:text="@string/draft"
        android:textSize="13sp"
        android:textColor="#FF8A00"
        app:layout_constraintBaseline_toBaselineOf="@id/conversation_body_short"
        app:layout_constraintEnd_toStartOf="@id/pin_indicator"
        tools:visibility="visible" />

    <ImageView android:id="@+id/pin_indicator"
        android:layout_width="22dp" android:layout_height="22dp"
        android:padding="5dp"
        android:src="@drawable/ic_pin_filled_vector"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/conversation_body_short"
        app:layout_constraintBottom_toBottomOf="@id/conversation_body_short"
        app:layout_constraintEnd_toStartOf="@id/unread_count_badge" />

    <org.fossify.commons.views.MyTextView android:id="@+id/unread_count_badge"
        android:layout_width="22dp" android:layout_height="22dp"
        android:gravity="center" android:textSize="12sp"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/samsung_unread_badge"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/conversation_body_short"
        app:layout_constraintBottom_toBottomOf="@id/conversation_body_short"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="2" tools:visibility="visible" />


</androidx.constraintlayout.widget.ConstraintLayout>
